{
  "name": "socialscene",
  "version": "1.0.4",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:prep-archive": "cd ios && pod install && cd .. && open ios/SocialCircle.xcworkspace",
    "web": "expo start --web",
    "test": "jest --maxWorkers=1",
    "test:ci": "jest --runInBand --ci",
    "check-timestamps": "node scripts/check-timestamps.js",
    "seed:categories": "node scripts/replaceCategories.js",
    "clean:ios": "cd ios && xcodebuild clean -project SocialCircle.xcodeproj -scheme SocialCircle && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd ..",
    "rebuild:ios": "cd ios && pod install && cd .. && npm run ios",
    "rebuild:android": "npm run clean:android && npm run android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.2",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/masked-view": "^0.1.11",
    "@react-native-firebase/analytics": "^21.6.0",
    "@react-native-firebase/app": "^21.6.0",
    "@react-native-firebase/app-check": "^21.6.0",
    "@react-native-firebase/auth": "^21.6.0",
    "@react-native-firebase/dynamic-links": "^21.6.0",
    "@react-native-firebase/firestore": "^21.6.0",
    "@react-native-firebase/functions": "^21.6.0",
    "@react-native-firebase/storage": "^21.6.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/material-top-tabs": "^7.1.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "date-fns": "^4.1.0",
    "expo": "53.0.22",
    "expo-apple-authentication": "^8.0.7",
    "expo-application": "~6.1.5",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.1",
    "expo-blur": "^15.0.7",
    "expo-calendar": "~14.1.4",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-haptics": "~13.0.1",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.4",
    "expo-splash-screen": "^31.0.10",
    "expo-status-bar": "~2.2.3",
    "expo-tracking-transparency": "^6.0.8",
    "expo-updates": "~0.28.17",
    "expo-video": "~2.2.2",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "geofire-common": "^6.0.0",
    "lucide-react-native": "^0.525.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-map-clustering": "^3.4.2",
    "react-native-maps": "1.20.1",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-pager-view": "6.7.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-vector-icons": "^10.2.0",
    "sentry-expo": "^7.1.1",
    "tslib": "^2.8.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^20.0.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/react": "~19.0.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.10",
    "react-test-renderer": "19.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false,
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|expo(nent)?|@expo|@unimodules|unimodules|sentry-expo|native-base|react-clone-referenced-element|@gorhom|@react-navigation|firebase|@firebase)"
    ],
    "moduleNameMapper": {
      "^@env$": "<rootDir>/__tests__/__mocks__/envMock.js",
      "^firebase/app$": "<rootDir>/__tests__/__mocks__/firebaseApp.js",
      "^firebase/auth$": "<rootDir>/__tests__/__mocks__/firebaseAuth.js",
      "^firebase/firestore$": "<rootDir>/__tests__/__mocks__/firebaseFirestore.js",
      "^firebase/functions$": "<rootDir>/__tests__/__mocks__/firebaseFunctions.js",
      "^firebase/storage$": "<rootDir>/__tests__/__mocks__/firebaseStorage.js",
      "^@react-native-firebase/app$": "<rootDir>/__mocks__/@react-native-firebase/app.js",
      "^@react-native-firebase/auth$": "<rootDir>/__mocks__/@react-native-firebase/auth.js",
      "^@react-native-firebase/firestore$": "<rootDir>/__mocks__/@react-native-firebase/firestore.js",
      "^@react-native-firebase/functions$": "<rootDir>/__mocks__/@react-native-firebase/functions.js",
      "^@react-native-firebase/storage$": "<rootDir>/__mocks__/@react-native-firebase/storage.js"
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-keyboard-aware-scroll-view",
          "react-native-swipe-list-view",
          "@react-native-community/masked-view",
          "firebase",
          "firebase-admin",
          "firebase-functions",
          "geofire-common",
          "react-native-vector-icons",
          "sentry-expo"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true,
  "eas-build": {
    "postInstall": "node ./scripts/write-env-from-secrets.cjs"
  }
}
