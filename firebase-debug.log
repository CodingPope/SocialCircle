[debug] [2025-09-20T17:09:02.522Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/social-scene1/rulesets {"name":"projects/social-scene1/rulesets/84cea80d-aba3-4435-aa6e-64592a682565","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function signedIn() { return request.auth != null; }\n    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }\n    function isEventHost(e) {\n      return signedIn() && (\n        request.auth.uid == e.data.ownerId || request.auth.uid == e.data.hostId\n      );\n    }\n    function isAttendee(e) { return signedIn() && (request.auth.uid in (e.data.attendees == null ? [] : e.data.attendees)); }\n    function isValidDeviceToken(t) {\n      return t == null || (t is string && t != '' && t.matches('^ExponentPushToken.*'));\n    }\n    function allowUserSubcollection(uid, sub) {\n      // Whitelist safe subcollections a user can write to under their own user doc\n      return isOwner(uid) && (sub in ['profileviews']);\n    }\n\n    function userInterestList(uid) {\n      let interests = get(/databases/$(database)/documents/users/$(uid)).data.interests;\n      return interests is list ? interests : [];\n    }\n\n    function userHasInterest(uid, interestId) {\n      return interestId is string && interestId != '' && userInterestList(uid).hasAny([interestId]);\n    }\n\n    function validPostContent(text) {\n      return text is string && text.size() > 0 && text.size() <= 2000;\n    }\n\n    function validCommentBody(text) {\n      return text is string && text.size() > 0 && text.size() <= 500;\n    }\n\n    // Helpers for safe list ops\n    function asList(x) { return x is list ? x : []; }\n    function listSize(x) { return (x is list) ? x.size() : 0; }\n    function listHasAll(x, vals) { return (x is list) && x.hasAll(vals); }\n\n    function isChatParticipant(eventId) {\n      return signedIn() && (\n        request.auth.uid in get(/databases/$(database)/documents/chats/$(eventId)).data.participants\n      );\n    }\n\n    // NEW: Disallow clients from updating premium/popularity/business fields directly\n    function userRestrictedKeysChanged() {\n      return request.resource.data.diff(resource.data).changedKeys().hasAny([\n        'premiumActive', 'premiumTier', 'premiumSince', 'premiumUntil',\n        'isPopular', 'popularScore',\n        'type', 'businessTier', 'plan'\n      ]);\n    }\n\n    match /users/{uid} {\n      allow read: if true;\n\n      // On create, enforce device token validity and sensible defaults for restricted flags\n      allow create: if isOwner(uid) && isValidDeviceToken(request.resource.data.deviceToken) &&\n        // Prevent clients from self-assigning premium/popular/business on create\n        (\n          (request.resource.data.premiumActive == false || !(request.resource.data.keys().hasAny(['premiumActive']))) &&\n          (request.resource.data.isPopular == false || !(request.resource.data.keys().hasAny(['isPopular']))) &&\n          (request.resource.data.type == null || request.resource.data.type == 'user') &&\n          !(request.resource.data.keys().hasAny(['premiumTier','premiumSince','premiumUntil','popularScore','businessTier','plan']))\n        );\n\n      // Owners can update their profile, but not restricted fields\n      allow update: if isOwner(uid) && isValidDeviceToken(request.resource.data.deviceToken) &&\n        !userRestrictedKeysChanged();\n\n      match /{sub=**}/{docId} {\n        allow create, update: if allowUserSubcollection(uid, sub);\n        allow read: if isOwner(uid);\n        allow delete: if false;\n      }\n    }\n\n    match /categories/{categoryId} {\n      allow read: if true;\n      allow write: if false;\n    }\n\n    match /events/{eventId} {\n      allow read: if signedIn();\n      allow create: if signedIn();\n\n      // Host-initiated updates\n      allow update: if isEventHost(resource);\n\n      // Self-leave (safe against nulls) OR RSVP request (safe against nulls)\n      allow update: if signedIn() && (\n        // Self-leave: only attendees changes; exactly remove caller uid\n        (\n          request.resource.data.diff(resource.data).changedKeys().hasOnly(['attendees']) &&\n          listSize(asList(request.resource.data.attendees)) == listSize(asList(resource.data.attendees)) - 1 &&\n          listHasAll(asList(resource.data.attendees), [request.auth.uid]) &&\n          !(listHasAll(asList(request.resource.data.attendees), [request.auth.uid]))\n        )\n        ||\n        // RSVP: only requests changes; exactly add caller uid; event is RSVP and not deleted; caller not host/attendee\n        (\n          request.resource.data.diff(resource.data).changedKeys().hasOnly(['requests']) &&\n          resource.data.privacy == 'rsvp' && resource.data.isDeleted != true &&\n          request.auth.uid != (resource.data.ownerId == null ? '' : resource.data.ownerId) &&\n          request.auth.uid != (resource.data.hostId == null ? '' : resource.data.hostId) &&\n          !(listHasAll(asList(resource.data.attendees), [request.auth.uid])) &&\n          !(listHasAll(asList(resource.data.requests), [request.auth.uid])) &&\n          listSize(asList(request.resource.data.requests)) == listSize(asList(resource.data.requests)) + 1 &&\n          listHasAll(asList(request.resource.data.requests), [request.auth.uid])\n        )\n      );\n    }\n\n    match /interestPosts/{postId} {\n      allow read: if signedIn();\n\n      allow create: if signedIn() &&\n        request.auth.uid == request.resource.data.creatorId &&\n        validPostContent(request.resource.data.content) &&\n        userHasInterest(request.auth.uid, request.resource.data.interestId) &&\n        request.resource.data.commentCount == 0 &&\n        request.resource.data.likeCount == 0 &&\n        request.resource.data.isDeleted == false;\n\n      allow update: if signedIn() && (\n        (\n          request.auth.uid == resource.data.creatorId &&\n          request.resource.data.diff(resource.data).changedKeys().hasOnly([\n            'content',\n            'mediaUrl',\n            'mediaThumbnailUrl',\n            'mediaStoragePath',\n            'mediaWidth',\n            'mediaHeight',\n            'mediaType',\n            'updatedAt',\n            'isDeleted',\n            'deletedAt',\n          ]) &&\n          validPostContent(request.resource.data.content)\n        ) ||\n        (\n          request.resource.data.diff(resource.data).changedKeys().hasOnly([\n            'commentCount',\n            'updatedAt',\n          ]) &&\n          request.resource.data.commentCount >= 0 &&\n          (\n            request.resource.data.commentCount == resource.data.commentCount + 1 ||\n            request.resource.data.commentCount == resource.data.commentCount - 1\n          )\n        )\n      );\n\n      allow delete: if signedIn() && request.auth.uid == resource.data.creatorId;\n\n      match /comments/{commentId} {\n        allow read: if signedIn();\n        allow create: if signedIn() &&\n          request.auth.uid == request.resource.data.authorId &&\n          validCommentBody(request.resource.data.body);\n        allow update: if signedIn() &&\n          request.auth.uid == resource.data.authorId &&\n          request.resource.data.diff(resource.data).changedKeys().hasOnly([\n            'deleted',\n            'deletedAt',\n          ]) &&\n          request.resource.data.deleted == true;\n        allow delete: if false;\n      }\n    }\n\n    match /chats/{eventId} {\n      allow read: if signedIn();\n      allow create, update: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||\n        isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||\n        isChatParticipant(eventId);\n\n      match /messages/{messageId} {\n        allow read: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||\n          isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||\n          isChatParticipant(eventId);\n        allow create: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||\n          isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||\n          isChatParticipant(eventId);\n        allow update, delete: if false;\n      }\n    }\n\n    // Businesses: server-managed. Clients can read, writes go via Admin SDK/Cloud Functions.\n    match /businesses/{businessId} {\n      allow read: if true;\n      allow write: if false; // managed via Admin SDK/Cloud Functions only\n\n      // Child: locations\n      match /locations/{locId} {\n        allow read: if true;\n        allow write: if false; // managed via Admin SDK/Cloud Functions only\n      }\n\n      // Child: offers (future)\n      match /offers/{offerId} {\n        allow read: if true;\n        allow write: if false; // managed via Admin SDK/Cloud Functions only\n      }\n    }\n\n    // Business tiers: computed, server-only writes\n    match /businessTiers/{bizId} {\n      allow read: if true;\n      allow write: if false; // computed by backend only\n    }\n\n    // Membership mirror: allow each user to read their own memberships only\n    // Path structure uses a subcollection to keep a valid collection/doc alternation\n    match /businessMembers/{uid} {\n      allow read, write: if false; // no direct writes at this doc level\n      match /memberships/{bizId} {\n        allow read: if isOwner(uid);\n        allow write: if false; // created/updated by backend alongside businesses\n      }\n    }\n\n    match /notifications/{id} {\n      // Only the recipient can read their notifications\n      allow read: if isOwner(resource.data.recipientId);\n\n      // Allow recipient to toggle read status or soft-delete their notification\n      allow update: if isOwner(resource.data.recipientId) && (\n        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt']) ||\n        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isDeleted', 'deletedAt']) ||\n        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt', 'isDeleted', 'deletedAt'])\n      );\n\n      // No hard deletes or client-side creation\n      allow delete: if false;\n      allow create: if false;\n    }\n\n    match /reports/{id} {\n      allow read, write: if false;\n    }\n\n    match /{document=**} { allow read, write: if false; }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2025-09-20T17:09:02.584591Z","metadata":{"services":["cloud.firestore"]}}
