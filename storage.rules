rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isImage() {
      return request.resource == null ||
        (request.resource.contentType is string &&
          request.resource.contentType.matches('image/.*'));
    }
    function maxSize(bytes) {
      return request.resource == null || request.resource.size < bytes;
    }
    function matchesAuth(value) {
      return signedIn() && value is string && value == request.auth.uid;
    }
    function listIncludesAuth(list) {
      return signedIn() && list is list && list.hasAny([request.auth.uid]);
    }
    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function isEventMediaOwner(eventId) {
      let data = eventData(eventId);
      return signedIn() && data != null && (
        matchesAuth(data.ownerId) ||
        matchesAuth(data.hostId) ||
        matchesAuth(data.owner) ||
        matchesAuth(data.ownerUID) ||
        matchesAuth(data.host) ||
        matchesAuth(data.hostUID) ||
        listIncludesAuth(data.hosts) ||
        listIncludesAuth(data.coHosts) ||
        listIncludesAuth(data.admins) ||
        listIncludesAuth(data.moderators)
      );
    }

    // Profile images: profileImages/{uid}/{file}
    match /profileImages/{uid}/{file} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && isImage()
        && maxSize(5 * 1024 * 1024); // 5MB limit
    }

    // Event images: event-images/{eventId}/...
    // Host-only writes; allow nested files with {file=**}
    match /event-images/{eventId}/{file=**} {
      allow read: if true;
      allow write: if isEventMediaOwner(eventId)
        && isImage()
        && maxSize(10 * 1024 * 1024); // 10MB limit
    }

    // Interest post media: interest-posts/{uid}/{postId}/...
    match /interest-posts/{uid}/{file=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    // Business assets: businesses/{uid}/...
    match /businesses/{uid}/{file=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    // Deny everything else explicitly
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
