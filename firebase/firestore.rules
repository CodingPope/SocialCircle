rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read: if request.auth != null; // Allow authenticated users to read events
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow read, write: if request.auth != null && request.auth.uid in resource.data.attendees;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees']);
    }

    // USER DOCUMENTS
    match /users/{userId} {
      
      allow read: if true; // public profiles

      // Allow user to update their own profile (including following array)
      allow update: if request.auth != null && request.auth.uid == userId;

      // Allow anyone to increment/decrement followerCount by exactly 1
      allow update: if request.auth != null
        && request.auth.uid != userId
        && (
          request.resource.data.followerCount == resource.data.followerCount + 1
          || request.resource.data.followerCount == resource.data.followerCount - 1
        );
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      // Allow users to read and update their own notifications
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      // Optionally, allow creation if the notification is for the user
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Optionally, allow delete if the notification belongs to the user
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // (optional) shut down everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}