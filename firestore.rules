rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isEventHost(e) {
      return signedIn() && (
        request.auth.uid == e.data.ownerId || request.auth.uid == e.data.hostId
      );
    }
    function isAttendee(e) { return signedIn() && (request.auth.uid in (e.data.attendees == null ? [] : e.data.attendees)); }
    function isValidDeviceToken(t) {
      return t == null || (t is string && t != '' && t.matches('^ExponentPushToken.*'));
    }
    function allowUserSubcollection(uid, sub) {
      // Whitelist safe subcollections a user can write to under their own user doc
      return isOwner(uid) && (sub in ['profileviews']);
    }

    function userInterestList(uid) {
      let interests = get(/databases/$(database)/documents/users/$(uid)).data.interests;
      return interests is list ? interests : [];
    }

    function userHasInterest(uid, interestId) {
      return interestId is string && interestId != '' && userInterestList(uid).hasAny([interestId]);
    }

    function validPostContent(text) {
      return text is string && text.size() > 0 && text.size() <= 2000;
    }

    function validCommentBody(text) {
      return text is string && text.size() > 0 && text.size() <= 500;
    }

    // Helpers for safe list ops
    function asList(x) { return x is list ? x : []; }
    function listSize(x) { return (x is list) ? x.size() : 0; }
    function listHasAll(x, vals) { return (x is list) && x.hasAll(vals); }

    function isChatParticipant(eventId) {
      return signedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/chats/$(eventId)).data.participants
      );
    }

    // NEW: Disallow clients from updating premium/popularity/business fields directly
    function userRestrictedKeysChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'premiumActive', 'premiumTier', 'premiumSince', 'premiumUntil',
        'isPopular', 'popularScore',
        'type', 'businessTier', 'plan'
      ]);
    }

    match /users/{uid} {
      allow read: if true;

      // On create, enforce device token validity and sensible defaults for restricted flags
      allow create: if isOwner(uid) && isValidDeviceToken(request.resource.data.deviceToken) &&
        // Prevent clients from self-assigning premium/popular/business on create
        (
          (request.resource.data.premiumActive == false || !(request.resource.data.keys().hasAny(['premiumActive']))) &&
          (request.resource.data.isPopular == false || !(request.resource.data.keys().hasAny(['isPopular']))) &&
          (request.resource.data.type == null || request.resource.data.type == 'user') &&
          !(request.resource.data.keys().hasAny(['premiumTier','premiumSince','premiumUntil','popularScore','businessTier','plan']))
        );

      // Owners can update their profile, but not restricted fields
      allow update: if isOwner(uid) && isValidDeviceToken(request.resource.data.deviceToken) &&
        !userRestrictedKeysChanged();

      match /{sub=**}/{docId} {
        allow create, update: if allowUserSubcollection(uid, sub);
        allow read: if isOwner(uid);
        allow delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();

      // Host-initiated updates
      allow update: if isEventHost(resource);

      // Self-leave (safe against nulls) OR RSVP request (safe against nulls)
      allow update: if signedIn() && (
        // Self-leave: only attendees changes; exactly remove caller uid
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['attendees']) &&
          listSize(asList(request.resource.data.attendees)) == listSize(asList(resource.data.attendees)) - 1 &&
          listHasAll(asList(resource.data.attendees), [request.auth.uid]) &&
          !(listHasAll(asList(request.resource.data.attendees), [request.auth.uid]))
        )
        ||
        // RSVP: only requests changes; exactly add caller uid; event is RSVP and not deleted; caller not host/attendee
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['requests']) &&
          resource.data.privacy == 'rsvp' && resource.data.isDeleted != true &&
          request.auth.uid != (resource.data.ownerId == null ? '' : resource.data.ownerId) &&
          request.auth.uid != (resource.data.hostId == null ? '' : resource.data.hostId) &&
          !(listHasAll(asList(resource.data.attendees), [request.auth.uid])) &&
          !(listHasAll(asList(resource.data.requests), [request.auth.uid])) &&
          listSize(asList(request.resource.data.requests)) == listSize(asList(resource.data.requests)) + 1 &&
          listHasAll(asList(request.resource.data.requests), [request.auth.uid])
        )
      );
    }

    match /interestPosts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.creatorId &&
        validPostContent(request.resource.data.content) &&
        userHasInterest(request.auth.uid, request.resource.data.interestId) &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.isDeleted == false;

      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.creatorId &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'content',
            'mediaUrl',
            'mediaThumbnailUrl',
            'mediaStoragePath',
            'mediaWidth',
            'mediaHeight',
            'mediaType',
            'updatedAt',
            'isDeleted',
            'deletedAt',
          ]) &&
          validPostContent(request.resource.data.content)
        ) ||
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'commentCount',
            'updatedAt',
          ]) &&
          request.resource.data.commentCount >= 0 &&
          (
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1
          )
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.creatorId;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.authorId &&
          validCommentBody(request.resource.data.body);
        allow update: if signedIn() &&
          request.auth.uid == resource.data.authorId &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'deleted',
            'deletedAt',
          ]) &&
          request.resource.data.deleted == true;
        allow delete: if false;
      }
    }

    match /chats/{eventId} {
      allow read: if signedIn();
      allow create, update: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||
        isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||
        isChatParticipant(eventId);

      match /messages/{messageId} {
        allow read: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||
          isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||
          isChatParticipant(eventId);
        allow create: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||
          isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||
          isChatParticipant(eventId);
        allow update, delete: if false;
      }
    }

    // Businesses: server-managed. Clients can read, writes go via Admin SDK/Cloud Functions.
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if false; // managed via Admin SDK/Cloud Functions only

      // Child: locations
      match /locations/{locId} {
        allow read: if true;
        allow write: if false; // managed via Admin SDK/Cloud Functions only
      }

      // Child: offers (future)
      match /offers/{offerId} {
        allow read: if true;
        allow write: if false; // managed via Admin SDK/Cloud Functions only
      }
    }

    // Business tiers: computed, server-only writes
    match /businessTiers/{bizId} {
      allow read: if true;
      allow write: if false; // computed by backend only
    }

    // Membership mirror: allow each user to read their own memberships only
    // Path structure uses a subcollection to keep a valid collection/doc alternation
    match /businessMembers/{uid} {
      allow read, write: if false; // no direct writes at this doc level
      match /memberships/{bizId} {
        allow read: if isOwner(uid);
        allow write: if false; // created/updated by backend alongside businesses
      }
    }

    match /notifications/{id} {
      // Only the recipient can read their notifications
      allow read: if isOwner(resource.data.recipientId);

      // Allow recipient to toggle read status or soft-delete their notification
      allow update: if isOwner(resource.data.recipientId) && (
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt']) ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isDeleted', 'deletedAt']) ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt', 'isDeleted', 'deletedAt'])
      );

      // No hard deletes or client-side creation
      allow delete: if false;
      allow create: if false;
    }

    match /reports/{id} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
