rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all documents for authenticated users
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Rules for the 'notifications' collection
    match /notifications/{notificationId} {
      // Allow creating notifications if the user is authenticated
      allow create: if request.auth != null;

      // Allow reading notifications if the user is the recipient
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;

      // Allow updating notifications if the user is the recipient
      allow update: if request.auth != null && resource.data.recipientId == request.auth.uid;
    }

    // Rules for the 'events' collection
    match /events/{eventId} {
      // Allow creating events if the user is authenticated
      allow create: if request.auth != null;

      // Allow reading events for authenticated users
      allow read: if request.auth != null;

      // Allow updating event requests if the user is authenticated
      allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests']);
      
      // Allow updating events if the user is the owner
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow reading user profiles for authenticated users
      allow read: if request.auth != null;

      // Allow updating user profiles if the user is the owner
      allow update: if request.auth != null && request.auth.uid == userId;
    }
  }
}

