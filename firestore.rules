rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function matchesAuthUid(value) {
      return value is string && value == request.auth.uid;
    }

    function listIncludesAuthUid(value) {
      return value is list && value.hasAny([request.auth.uid]);
    }

    function isEventHost(e) {
      let data = (e == null) ? null : e.data;
      return signedIn() && data != null && (
        matchesAuthUid(data.ownerId) ||
        matchesAuthUid(data.hostId) ||
        matchesAuthUid(data.owner) ||
        matchesAuthUid(data.ownerUID) ||
        matchesAuthUid(data.host) ||
        matchesAuthUid(data.hostUID) ||
        listIncludesAuthUid(data.hosts) ||
        listIncludesAuthUid(data.coHosts) ||
        listIncludesAuthUid(data.admins) ||
        listIncludesAuthUid(data.moderators)
      );
    }

    function validEventCreate() {
      let data = request.resource.data;
      return signedIn() &&
        matchesAuthUid(data.ownerId) &&
        (!data.keys().hasAny(['hostId']) || matchesAuthUid(data.hostId)) &&
        (!data.keys().hasAny(['hosts']) || listIncludesAuthUid(data.hosts)) &&
        (!data.keys().hasAny(['coHosts']) || listIncludesAuthUid(data.coHosts)) &&
        (!data.keys().hasAny(['admins']) || listIncludesAuthUid(data.admins)) &&
        (!data.keys().hasAny(['moderators']) || listIncludesAuthUid(data.moderators)) &&
        (!data.keys().hasAny(['attendees']) || (
          data.attendees is list &&
          (data.attendees.size() == 0 || data.attendees.hasOnly([request.auth.uid]))
        )) &&
        (!data.keys().hasAny(['requests']) || (data.requests is list && data.requests.size() == 0)) &&
        (!data.keys().hasAny(['waitlist']) || (data.waitlist is list && data.waitlist.size() == 0)) &&
        (!data.keys().hasAny(['isDeleted']) || data.isDeleted != true) &&
        // If businessId is a non-null string, hostType must be 'BUSINESS'; allow null/missing businessId for regular users
        (!data.keys().hasAny(['businessId']) || data.businessId == null || (
          data.businessId is string && data.keys().hasAny(['hostType']) && data.hostType == 'BUSINESS'
        ));
    }

    function eventOwnerUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }
    function isAttendee(e) { return signedIn() && (request.auth.uid in (e.data.attendees == null ? [] : e.data.attendees)); }
    function isValidDeviceToken(t) {
      // Allow null, missing, empty string, or valid ExponentPushToken
      return t == null || t == '' || (t is string && t.matches('^ExponentPushToken.*'));
    }
    function deviceTokenValid(data) {
      // If deviceToken key is not present, it's valid (allows updates that don't touch token)
      return !data.keys().hasAny(['deviceToken']) || isValidDeviceToken(data.deviceToken);
    }
    function allowUserSubcollection(uid, subPath) {
      return isOwner(uid) &&
        (subPath is string) &&
        subPath.lower().matches('^(profileviews|savedevents)(/.*)?$');
    }

    function blockedByUnchanged() {
      return !request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasAny(['blockedBy']);
    }

    function chatPinnedUpdateAllowed() {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasOnly(['pinned', 'lastUpdated']);
    }

    function validOptionalString(data, key, maxLen) {
      return !(data.keys().hasAny([key])) ||
        (data[key] is string && data[key].size() <= maxLen);
    }

    function validSavedEventCreate(eventId) {
      return request.resource != null &&
        request.resource.data.keys().hasOnly([
          'eventId',
          'savedAt',
          'eventStart',
          'interest',
          'category',
          'surface',
          'source',
        ]) &&
        request.resource.data.eventId == eventId &&
        request.resource.data.savedAt is timestamp &&
        request.resource.data.eventStart is timestamp &&
        request.resource.data.savedAt <= request.time &&
        validOptionalString(request.resource.data, 'interest', 100) &&
        validOptionalString(request.resource.data, 'category', 100) &&
        validOptionalString(request.resource.data, 'surface', 60) &&
        validOptionalString(request.resource.data, 'source', 60);
    }

    function userInterestList(uid) {
      let interests = get(/databases/$(database)/documents/users/$(uid)).data.interests;
      return interests is list ? interests : [];
    }

    function userHasInterest(uid, interestId) {
      return interestId is string && interestId != '' && userInterestList(uid).hasAny([interestId]);
    }

    function validPostContent(text) {
      return text is string && text.size() > 0 && text.size() <= 2000;
    }

    function validCommentBody(text) {
      return text is string && text.size() > 0 && text.size() <= 500;
    }

    // Helpers for safe list ops
    function asList(x) { return x is list ? x : []; }
    function listSize(x) { return (x is list) ? x.size() : 0; }
    function listHasAll(x, vals) { return (x is list) && x.hasAll(vals); }

    function isChatParticipant(eventId) {
      return signedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/chats/$(eventId)).data.participants
      );
    }

    // NEW: Disallow clients from updating premium/popularity/business fields directly
    function userRestrictedKeysChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        'premiumActive', 'premiumTier', 'premiumSince', 'premiumUntil',
        'isPopular', 'popularScore',
        'type', 'businessTier', 'plan', 'accountTier'
      ]);
    }

    // Tier helpers for rules-level gating (server-managed via custom claims)
    function accountTier() {
      return request.auth.token.accountTier is string
        ? request.auth.token.accountTier
        : 'basic';
    }
    function accountTierRank(t) {
      return t == 'popular' ? 3 : t == 'paid' ? 2 : 1;
    }
    function hasAccountTier(required) {
      return Rank(accountTier()) >= accountTierRank(required);
    }

    match /users/{uid} {
      allow read: if signedIn();

      // On create, enforce device token validity and sensible defaults for restricted flags
      allow create: if isOwner(uid) && 
        isValidDeviceToken(request.resource.data.deviceToken) &&
        // Prevent clients from self-assigning premium/popular/business on create
        // Allow premiumActive and isPopular ONLY if explicitly false or missing
        (!request.resource.data.keys().hasAny(['premiumActive']) || request.resource.data.premiumActive == false) &&
        (!request.resource.data.keys().hasAny(['isPopular']) || request.resource.data.isPopular == false) &&
        // Type must be 'user' or missing (defaults to 'user')
        (!request.resource.data.keys().hasAny(['type']) || request.resource.data.type == 'user') &&
        // Disallow premium/business tier fields entirely on create
        !request.resource.data.keys().hasAny([
          'premiumTier',
          'premiumSince',
          'premiumUntil',
          'popularScore',
          'businessTier',
          'plan',
          'accountTier'
        ]);

      // Owners can update their profile, but not restricted fields
      // Note: deviceTokenValid checks the incoming data, not requiring existing token to be valid
      allow update: if isOwner(uid) &&
        deviceTokenValid(request.resource.data) &&
        !userRestrictedKeysChanged() &&
        blockedByUnchanged();

      match /savedEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validSavedEventCreate(eventId);
        allow delete: if isOwner(uid);
        allow update: if false;
      }

      match /{sub=**}/{docId} {
        allow create, update: if allowUserSubcollection(uid, sub);
        allow read: if isOwner(uid);
        allow delete: if false;
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      // Business events are server-created only; block client if hostType == 'BUSINESS'
      // Note: If hostType is not present or is null, allow creation (regular user event)
      allow create: if validEventCreate() && (
        !request.resource.data.keys().hasAny(['hostType']) ||
        request.resource.data.hostType == null ||
        request.resource.data.hostType != 'BUSINESS'
      );

      // Host-initiated updates
      allow update: if isEventHost(resource) && eventOwnerUnchanged();

      // Self-leave (safe against nulls) OR RSVP request (safe against nulls)
      allow update: if signedIn() && (
        // Self-leave: only attendees changes; exactly remove caller uid
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['attendees']) &&
          listSize(asList(request.resource.data.attendees)) == listSize(asList(resource.data.attendees)) - 1 &&
          listHasAll(asList(resource.data.attendees), [request.auth.uid]) &&
          !(listHasAll(asList(request.resource.data.attendees), [request.auth.uid]))
        )
        ||
        // RSVP: only requests changes; exactly add caller uid; event is RSVP and not deleted; caller not host/attendee
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['requests']) &&
          resource.data.privacy == 'rsvp' && resource.data.isDeleted != true &&
          request.auth.uid != (resource.data.ownerId == null ? '' : resource.data.ownerId) &&
          request.auth.uid != (resource.data.hostId == null ? '' : resource.data.hostId) &&
          !(listHasAll(asList(resource.data.attendees), [request.auth.uid])) &&
          !(listHasAll(asList(resource.data.requests), [request.auth.uid])) &&
          listSize(asList(request.resource.data.requests)) == listSize(asList(resource.data.requests)) + 1 &&
          listHasAll(asList(request.resource.data.requests), [request.auth.uid])
        )
      );
    }

    match /interestPosts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.creatorId &&
        validPostContent(request.resource.data.content) &&
        // userHasInterest(request.auth.uid, request.resource.data.interestId) &&
        request.resource.data.commentCount == 0 &&
        request.resource.data.likeCount == 0 &&
        request.resource.data.isDeleted == false;

      allow update: if signedIn() && (
        (
          request.auth.uid == resource.data.creatorId &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'content',
            'interestId',
            'mediaUrl',
            'mediaThumbnailUrl',
            'mediaStoragePath',
            'mediaWidth',
            'mediaHeight',
            'mediaType',
            'updatedAt',
            'isDeleted',
            'deletedAt',
          ]) &&
          validPostContent(request.resource.data.content)
          // userHasInterest(request.auth.uid, request.resource.data.interestId)
        ) ||
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'commentCount',
            'updatedAt',
          ]) &&
          request.resource.data.commentCount >= 0 &&
          (
            request.resource.data.commentCount == resource.data.commentCount + 1 ||
            request.resource.data.commentCount == resource.data.commentCount - 1
          )
        )
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.creatorId;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.authorId &&
          validCommentBody(request.resource.data.body);
        allow update: if signedIn() &&
          request.auth.uid == resource.data.authorId &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'deleted',
            'deletedAt',
          ]) &&
          request.resource.data.deleted == true;
        allow delete: if false;
      }
    }

    match /chats/{eventId} {
      allow read: if signedIn();
      allow create: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||
        isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||
        isChatParticipant(eventId);
      allow update: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) &&
        chatPinnedUpdateAllowed();

      match /messages/{messageId} {
        allow read: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||
          isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||
          isChatParticipant(eventId);
        allow create: if isEventHost(get(/databases/$(database)/documents/events/$(eventId))) ||
          isAttendee(get(/databases/$(database)/documents/events/$(eventId))) ||
          isChatParticipant(eventId);
        allow update, delete: if false;
      }
    }

    // Businesses: server-managed. Clients can read, writes go via Admin SDK/Cloud Functions.
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if false; // managed via Admin SDK/Cloud Functions only

      // Child: locations
      match /locations/{locId} {
        allow read: if true;
        allow write: if false; // managed via Admin SDK/Cloud Functions only
      }

      // Child: serviceAreas (for SERVICE_AREA type businesses)
      match /serviceAreas/{areaId} {
        allow read: if true;
        allow write: if false; // managed via Admin SDK/Cloud Functions only
      }

      // Child: offers (future)
      match /offers/{offerId} {
        allow read: if true;
        allow write: if false; // managed via Admin SDK/Cloud Functions only
      }
    }

    // Perks: server-managed, tier-gated creation
    match /perks/{perkId} {
      allow read: if true; // Public discovery
      allow write: if false; // managed via Admin SDK/Cloud Functions only
    }

    // Business tiers: computed, server-only writes
    match /businessTiers/{bizId} {
      allow read: if true;
      allow write: if false; // computed by backend only
    }

    // Membership mirror: allow each user to read their own memberships only
    // Path structure uses a subcollection to keep a valid collection/doc alternation
    match /businessMembers/{uid} {
      allow read, write: if false; // no direct writes at this doc level
      match /memberships/{bizId} {
        allow read: if isOwner(uid);
        allow write: if false; // created/updated by backend alongside businesses
      }
    }

    match /notifications/{id} {
      // Only the recipient can read their notifications
      allow read: if isOwner(resource.data.recipientId);

      // Allow recipient to toggle read status or soft-delete their notification
      allow update: if isOwner(resource.data.recipientId) && (
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt']) ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['isDeleted', 'deletedAt']) ||
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt', 'isDeleted', 'deletedAt'])
      );

      // No hard deletes or client-side creation
      allow delete: if false;
      allow create: if false;
    }

    match /reports/{id} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
